---
import Layout from '../../../layouts/Layout.astro'
import { FichaProducto } from '../../../components/catalog/FichaProducto'
import { jsonLd } from '../../../lib/business'
import { TODO_HREF } from '../../../lib/catalog'
import { loadCatalog } from '../../../lib/catalog-view'
import { absoluta, breadcrumbSchema, offerSchema } from '../../../lib/seo'

// PRI-529: la página propia de cada producto (ficha), la que llega desde Google, desde WhatsApp y al tocar la foto en el
// muro del catálogo o en "Disponible ahora" (la foto crece hasta aquí, movimiento.ts). Lleva su og:image para que
// la vista previa del link (el que manda "Pedir por WhatsApp") muestre la foto. Las URLs viejas /products/<categoría>/<slug>
// redirigen aquí con 301 (public/_redirects), y las de un slug viejo también (PRI-525).
export async function getStaticPaths() {
  return (await loadCatalog()).groups.flatMap(({ slug, label, href, items }) =>
    items.map((item, i) => ({
      params: { category: slug, slug: item.slug },
      // "Más de <categoría>": las que siguen en el muro, y al llegar al final las primeras.
      props: { item, label, href, otros: [...items.slice(i + 1), ...items.slice(0, i)].slice(0, 4) },
    })),
  )
}

const { item, label, href, otros } = Astro.props
const ficha = item.ficha
// La del canonical, con su "/" final (PRI-525).
const url = Astro.url.href
// El nombre (PRI-433): el del admin o, sin nombre, el de la foto. Es texto del admin: el JSON-LD va por jsonLd().
const nombre = ficha.titulo
const title = `${nombre} — Serflow`
// PRI-555: la descripción que el admin escribió; sin ella, la plantilla con el nombre (no una igual por categoría).
const description =
  ficha.descripcion ?? `${nombre}: un trabajo de ${label} hecho en el taller de Serflow, Cartagena. ¿Te gusta? Te hacemos una igual o con tu logo: pídela por WhatsApp.`
const n = ficha.fotos.length
const fotos = ficha.fotos.map((f, i) => ({
  src: f.src,
  srcSet: f.srcSet,
  alt: n > 1 ? `${ficha.alt}, foto ${i + 1} de ${n}` : ficha.alt,
  zoom: item.zoom[i],
}))
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  image: ficha.fotos.map((p) => absoluta(p.src)),
  description,
  category: label,
  brand: { '@type': 'Brand', name: 'Serflow' },
  url,
  offers: offerSchema({ url, price: item.price, disponible: item.disponible }),
}
const migas = breadcrumbSchema([
  { name: 'Inicio', url: absoluta('/') },
  { name: 'Catálogo', url: absoluta(TODO_HREF) },
  { name: label, url: absoluta(href) },
  { name: nombre, url },
])
---

<Layout title={title} description={description} ogType="product" ogImage={item.og ? { src: item.og, alt: item.tile.img.alt } : undefined} hideFab>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(schema)} />
    <script type="application/ld+json" set:html={jsonLd(migas)} />
  </Fragment>
  <FichaProducto
    titulo={nombre}
    categoria={{ label, href }}
    precio={ficha.precio ?? null}
    colores={ficha.colores}
    descripcion={ficha.descripcion ?? null}
    fotos={fotos}
    pedir={ficha.pedir}
    otros={otros.map((o) => ({ titulo: o.ficha.titulo, href: o.tile.href, img: { src: o.tile.img.src, srcSet: o.tile.img.srcSet } }))}
  />
</Layout>

<script>
  import '../../../scripts/lupa'
  import '../../../scripts/visor-fotos'
</script>
