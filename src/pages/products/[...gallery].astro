---
import Layout from '../../layouts/Layout.astro'
import CatalogView from '../../components/catalog/CatalogView.astro'
import { TODO_HREF } from '../../lib/catalog'
import { loadPages } from '../../lib/catalog-view'

// PRI-130: /products ("Todo") y /products/<categoría>, en bloques de 60 (/pagina/2...). Cada foto se abre en el modal;
// su URL propia es /catalogo/<categoría>/<slug> (PRI-286).
export async function getStaticPaths() {
  return (await loadPages()).map(({ slug, props }) => ({
    params: { gallery: [slug, props.page > 1 ? `pagina/${props.page}` : ''].filter(Boolean).join('/') || undefined },
    props,
  }))
}

const props = Astro.props
const { view, page, slides, index } = props
const todo = view.href === TODO_HREF
const title = `${todo ? 'Catálogo' : view.label}${page > 1 ? `, página ${page}` : ''} — Serflow`
const description = todo
  ? 'Gorras y camisetas personalizadas de Serflow en Cartagena. Toca la que te guste y pídela por WhatsApp.'
  : `Explora la colección de ${view.label} en Serflow. Prendas personalizadas con atención por WhatsApp en Cartagena.`
const banner = slides[index].image
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:locale" content="es_CO" />
    {banner && <link rel="preload" as="image" imagesrcset={banner.srcSet} imagesizes="100vw" fetchpriority="high" />}
  </Fragment>
  <CatalogView {...props} />
</Layout>
