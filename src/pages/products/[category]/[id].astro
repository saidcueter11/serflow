---
import ProductPreview from '../../../components/ProductPreview.astro'
import Layout from '../../../layouts/Layout.astro'
import { getProducts } from '../../../lib/products'
import type { Product } from '../../../lib/types'

export async function getStaticPaths() {
  const products = await getProducts()
  return products.map((product) => ({
    params: {
      category: product.categories?.slug ?? '',
      id: product.slug,
    },
    props: { product },
  }))
}

interface Props {
  product: Product
}

const { product } = Astro.props

const productImages = product.image_urls
const mainImage = productImages[0] ?? ''
const categorySlug = product.categories?.slug ?? ''
const categoryLabel = product.categories?.label ?? ''

// Build proper URLs
const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') || 'https://serflowctg.netlify.app'
const productUrl = `${siteUrl}/products/${categorySlug}/${product.slug}`
const imageUrl = mainImage

// SEO-friendly title and description
const pageTitle = product.name
const pageDescription =
  product.description ||
  `¿Te interesa este producto de ${categoryLabel}? ¡Contáctanos por WhatsApp para más información!`
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: pageTitle,
  image: productImages,
  description: pageDescription,
  category: categoryLabel,
  brand: {
    '@type': 'Brand',
    name: 'Serflow',
  },
  url: productUrl,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'COP',
    price: product.price?.toString() ?? '0',
    description: product.price ? undefined : 'Consultar precio por WhatsApp',
  },
}
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="product" />
    <meta property="og:url" content={productUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content="Serflow" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- WhatsApp specific (some versions respect these) -->
    <meta property="og:locale" content="es_CO" />

    <!-- Additional SEO -->
    <meta property="product:availability" content="in stock" />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  </Fragment>

  <div
    class="mt-8 mb-10 md:mb-14 max-w-3xl w-full h-full mx-auto flex flex-col gap-4 font-vend-sans section-padding"
  >
    <aside class="z-20">
      <a
        id="back-link"
        href={`/products/${categorySlug}`}
        class="inline-flex items-center gap-2 text-accent group cursor-pointer"
      >
        <span class="bg-accent text-primary rounded-full w-6 h-6 inline-flex items-center justify-center text-sm">
          ←
        </span>
        <span class="underline-hover group-hover:after:origin-bottom group-hover:after:scale-x-100 group-active:after:scale-x-100 group-active:after:origin-bottom">
          Volver atrás
        </span>
      </a>
    </aside>

    <main class="w-full h-full">
      <ProductPreview
        slug={product.slug}
        mainImage={mainImage}
        images={productImages}
        alt={categoryLabel}
        productName={pageTitle}
      />
    </main>
  </div>

  <script is:inline>
    const backLink = document.getElementById('back-link')

    backLink?.addEventListener('click', (e) => {
      if (window.history.length > 1 && document.referrer) {
        e.preventDefault()
        window.history.back()
      }
    })
  </script>
</Layout>
