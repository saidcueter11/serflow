---
import Layout from '../../../layouts/Layout.astro'
import { TODO_HREF } from '../../../components/catalog/CatalogPage'
import { ViewerPage } from '../../../components/catalog/ViewerPage'
import { loadCatalog } from '../../../lib/catalog-view'
import { PAGE_SIZE, fotoTitulo, masDe, pageHref } from '../../../lib/catalog'

// PRI-130: visor de una foto. Mismas URLs de la ficha de antes (/products/<categoría>/<slug>): los links que ya
// circulan por WhatsApp siguen funcionando.
export async function getStaticPaths() {
  const { groups, todo } = await loadCatalog()
  return groups.flatMap((g) =>
    g.items.map((item, i) => {
      const enTodo = todo.indexOf(item)
      return {
        params: { category: g.slug, id: item.slug },
        props: {
          item,
          category: { label: g.label, href: g.href, count: g.items.length },
          mas: masDe(g.items, i, 12),
          back: `${pageHref(TODO_HREF, Math.floor(enTodo / PAGE_SIZE) + 1)}#${item.tile.id}`,
        },
      }
    }),
  )
}

const { item, category, mas, back } = Astro.props
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://serflowctg.netlify.app'
const url = `${siteUrl}${item.tile.href}`
const ogImage = item.og ? new URL(item.og, `${siteUrl}/`).href : null
const title = `${fotoTitulo(category.label, item.n)} — Serflow`
const description = `Un trabajo de ${category.label} hecho en el taller de Serflow, Cartagena. ¿Te gusta? Te hacemos una igual o con tu logo: pídela por WhatsApp.`
// Sin precio ni offers: el sitio no muestra precios (el precio se conversa por WhatsApp).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: fotoTitulo(category.label, item.n),
  image: item.photos.map((p) => new URL(p.src, `${siteUrl}/`).href),
  description,
  category: category.label,
  brand: { '@type': 'Brand', name: 'Serflow' },
  url,
}
---

<Layout title={title} description={description} hideFab>
  <Fragment slot="head">
    <!-- Open Graph: WhatsApp muestra esta foto en la vista previa del link que lleva el mensaje. -->
    <meta property="og:type" content="product" />
    <meta property="og:url" content={url} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:type" content="image/jpeg" />}
    <meta property="og:image:alt" content={item.tile.img.alt} />
    <meta property="og:locale" content="es_CO" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="preload" as="image" imagesrcset={item.photos[0].srcSet} imagesizes="(min-width: 1280px) 1200px, 100vw" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <ViewerPage item={item} category={category} mas={mas} back={back} />
</Layout>
