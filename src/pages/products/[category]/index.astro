---
import ProductCardList from '../../../components/ProductCardList.astro'
import Layout from '../../../layouts/Layout.astro'
import { Categories, CategoryLabels } from '../../../mocks/mockProducts'

export async function getStaticPaths() {
  return Object.values(Categories).map((category) => ({
    params: { category },
  }))
}

const { category } = Astro.params
const categoryLabel = CategoryLabels[category]
const pageTitle = `${categoryLabel} — Serflow`
const pageDescription = `Explora la colección de ${categoryLabel} en Serflow. Prendas personalizadas con atención por WhatsApp en Cartagena.`
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta property="og:locale" content="es_CO" />
  </Fragment>

  <main class="max-w-6xl mx-auto w-full section-padding py-6">
    <ProductCardList currentCategory={category} />
  </main>
</Layout>
