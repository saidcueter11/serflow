---
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import { HomePage, type HomeProduct } from '../components/home/HomePage'
import { PromoBar } from '../components/ui/PromoBar'
import type { Slide } from '../components/ui/HeroCarousel'
import { getActivePromos, getCategories, getProducts } from '../lib/products'
import { ADDRESS, EMAIL, POSTAL_CODE, SOCIAL, WHATSAPP_DISPLAY, WHATSAPP_URL } from '../lib/business'
// Fotos stock de Unsplash (licencia libre, sin atribución) que muestran el resultado, hasta que el admin
// pueda subir las reales (PRI-150). unsplash.com/photos/8Ckj05B7LmM, GUdUmJua9cI, pyeUg7FylSw, O4QUJiQuQss,
// 0y3DOYVP2bs, KL8EGoKDNcQ, kixK2sNVPyo
import camisetas from '../assets/images/stock/camisetas-estampadas.jpg'
import estampadoProceso from '../assets/images/stock/estampado-proceso.jpg'
import gorraBordada from '../assets/images/stock/gorra-bordada.jpg'
import amigosGorras from '../assets/images/stock/amigos-gorras.jpg'
import estampadoRasero from '../assets/images/stock/estampado-rasero.jpg'
import camisetaDtf from '../assets/images/stock/camiseta-dtf.jpg'
import gorraBordada2 from '../assets/images/stock/gorra-bordada-2.jpg'
// Foto del catálogo para "Diseña la tuya"
import capBordado from '../assets/images/miTierraQuerida/miTierraQuerida2.webp'

const PRODUCT_COUNT = 4

const [products, categories, promos] = await Promise.all([getProducts(), getCategories(), getActivePromos()])

const homeProducts: HomeProduct[] = await Promise.all(
  products
    .filter((p) => p.image_urls.length > 0 && p.categories?.slug)
    .slice(0, PRODUCT_COUNT)
    .map(async (p) => {
      const img = await getImage({ src: p.image_urls[0], width: 480, height: 360, format: 'webp', quality: 75 })
      return {
        name: p.name,
        // Sin precio en la portada (pedido del reviewer, PRI-129): el precio se conversa por WhatsApp.
        meta: p.categories?.label ?? '',
        href: `/products/${p.categories!.slug}/${p.slug}`,
        image: { src: img.src, alt: p.name },
      }
    }),
)

const [estampado, dtf, bordado, personalizador] = await Promise.all([
  getImage({ src: estampadoRasero, width: 640, format: 'webp', quality: 75 }),
  getImage({ src: camisetaDtf, width: 640, format: 'webp', quality: 75 }),
  getImage({ src: gorraBordada2, width: 640, format: 'webp', quality: 75 }),
  getImage({ src: capBordado, width: 900, format: 'webp', quality: 75 }),
])

// Carrusel del hero: 4 fotos del resultado. Si hay promo activa, su banner entra primero y sale la última foto.
const HERO = [
  { src: camisetas, caption: 'Camisetas con tu diseño', alt: 'Dos personas con camisetas negras estampadas', position: '50% 35%' },
  { src: estampadoProceso, caption: 'Estampado en el taller', alt: 'Manos pasando el rasero sobre una plancha de estampado', position: '50% 50%' },
  { src: gorraBordada, caption: 'Gorras bordadas', alt: 'Gorra blanca con bordado rojo', position: '50% 40%' },
  { src: amigosGorras, caption: 'Para tu equipo o tu grupo', alt: 'Dos amigos con gorras personalizadas riéndose', position: '50% 30%' },
]
const heroSlides: Slide[] = await Promise.all(
  HERO.map(async ({ src, ...rest }) => ({ ...rest, src: (await getImage({ src, width: 1400, format: 'webp', quality: 72 })).src })),
)
const promoWithCover = promos.find((p) => p.banner_url || p.image_urls[0])
if (promoWithCover) {
  const cover = promoWithCover.banner_url || promoWithCover.image_urls[0]
  const img = await getImage({ src: cover, width: 1400, height: 900, format: 'webp', quality: 72 })
  heroSlides.splice(heroSlides.length - 1, 1)
  heroSlides.unshift({ src: img.src, caption: 'Promo', alt: promoWithCover.title, promo: true })
}
const promoLinks = promos.map((p) => ({ title: p.title, href: `/promos/${p.slug}` }))

// "Ver todo" lleva a la primera categoría; desde ahí las pestañas llevan a las demás.
const catalogHref = categories[0] ? `/products/${categories[0].slug}` : '/'

const homeDescription =
  'Serflow en Cartagena: camisetas y gorras con estampado, DTF y bordado. Ven al taller en el Mercado Bazurto o escríbenos por WhatsApp.'

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Serflow',
  description: homeDescription,
  image: 'https://serflowctg.netlify.app/favicon.svg',
  telephone: WHATSAPP_DISPLAY,
  email: EMAIL,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS ?? undefined,
    postalCode: POSTAL_CODE,
    addressLocality: 'Cartagena de Indias',
    addressRegion: 'Bolívar',
    addressCountry: 'CO',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'], opens: '08:00', closes: '14:00' },
  ],
  areaServed: 'Cartagena, Colombia',
  url: 'https://serflowctg.netlify.app/',
  sameAs: [WHATSAPP_URL, ...SOCIAL.map((s) => s.url)],
}
---

<Layout title="Serflow: camisetas y gorras personalizadas en Cartagena" description={homeDescription}>
  <Fragment slot="head">
    <meta property="og:locale" content="es_CO" />
    <link rel="preload" as="image" href={heroSlides[0].src} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </Fragment>
  <Fragment slot="top">
    <PromoBar promos={promoLinks} />
  </Fragment>

  <HomePage
    slides={heroSlides}
    products={homeProducts}
    images={{ estampado: estampado.src, dtf: dtf.src, bordado: bordado.src, personalizador: personalizador.src }}
    catalogHref={catalogHref}
  />
</Layout>

<script>
  import '../scripts/thread'
</script>
