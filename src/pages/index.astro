---
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import { HomePage, type HomeProduct } from '../components/home/HomePage'
import { PromoBar } from '../components/ui/PromoBar'
import { HERO_SIZES, type Slide } from '../components/ui/HeroCarousel'
import { getActivePromos, getCategories, getProducts } from '../lib/products'
import { loadCatalog } from '../lib/catalog-view'
import { PhotoModal } from '../components/ui/PhotoModal'
import { fotoDeLugar, fotoRemota } from '../lib/medios-build'
import { ADDRESS, EMAIL, HOURS_EDITED, POSTAL_CODE, SOCIAL, WHATSAPP_DISPLAY, WHATSAPP_URL, jsonLd } from '../lib/business'
import { getSiteContent } from '../lib/site-content'
// Fotos stock de Unsplash (licencia libre, sin atribución) que muestran el resultado, hasta que el admin
// pueda subir las reales (PRI-150). unsplash.com/photos/8Ckj05B7LmM, GUdUmJua9cI, pyeUg7FylSw, O4QUJiQuQss,
// 0y3DOYVP2bs, KL8EGoKDNcQ, kixK2sNVPyo
import camisetas from '../assets/images/stock/camisetas-estampadas.jpg'
import estampadoProceso from '../assets/images/stock/estampado-proceso.jpg'
import gorraBordada from '../assets/images/stock/gorra-bordada.jpg'
import amigosGorras from '../assets/images/stock/amigos-gorras.jpg'
import estampadoRasero from '../assets/images/stock/estampado-rasero.jpg'
import camisetaDtf from '../assets/images/stock/camiseta-dtf.jpg'
import gorraBordada2 from '../assets/images/stock/gorra-bordada-2.jpg'
// "Diseña la tuya": gorras personalizadas en el estante del taller (la de Mi Tierra Querida se repetía en Disponible ahora).
import gorrasEstante from '../assets/images/stock/gorras-estante.jpg'

const PRODUCT_COUNT = 4

const [products, categories, promos, catalog, content] = await Promise.all([
  getProducts(),
  getCategories(),
  getActivePromos(),
  loadCatalog(),
  getSiteContent(),
])

// Cada prenda abre su foto en el modal (PRI-286), con la misma URL propia y el mismo mensaje que en el catálogo.
const homeProducts: HomeProduct[] = await Promise.all(
  products
    .filter((p) => p.image_urls.length > 0 && p.categories?.slug)
    .slice(0, PRODUCT_COUNT)
    .map(async (p) => {
      const item = catalog.groups.find((g) => g.slug === p.categories!.slug)?.items.find((it) => it.slug === p.slug)
      const img = await getImage({ src: p.image_urls[0], width: 480, height: 600, format: 'webp', quality: 75 })
      return {
        name: p.name,
        // Sin precio en la portada (pedido del reviewer, PRI-129): el precio se conversa por WhatsApp.
        meta: p.categories?.label ?? '',
        href: item?.tile.href ?? `/products/${p.categories!.slug}`,
        image: { src: img.src, alt: p.name },
        modal: item?.tile.modal,
      }
    }),
)

// Fotos de los servicios: 320 px para la fila del celular (112 px en pantallas densas), 640 px en desktop.
const fotoServicio = { width: 640, widths: [320, 640], quality: 75 }
const [estampado, dtf, bordado] = await Promise.all(
  [estampadoRasero, camisetaDtf, gorraBordada2].map((src) => getImage({ src, format: 'webp', ...fotoServicio })),
)

// Bloque "Diseña la tuya": la foto que publica el admin (PRI-150) o la del repo.
const fotoBloque = { width: 1200, widths: [640, 1200], quality: 75 }
const personalizador = (await fotoDeLugar('personalizador', fotoBloque)) ?? (await fotoDelRepo())

async function fotoDelRepo() {
  const img = await getImage({ src: gorrasEstante, format: 'webp', ...fotoBloque })
  return { src: img.src, srcSet: img.srcSet.attribute, alt: 'Gorras personalizadas en un estante del taller' }
}

// Carrusel del hero: 4 fotos del resultado. Si hay promo activa, su banner entra primero y sale la última foto.
const HERO = [
  { src: camisetas, alt: 'Dos personas con camisetas negras estampadas', position: '50% 35%' },
  { src: estampadoProceso, alt: 'Manos pasando el rasero sobre una plancha de estampado', position: '50% 50%' },
  { src: gorraBordada, alt: 'Gorra blanca con bordado rojo', position: '50% 40%' },
  { src: amigosGorras, alt: 'Dos amigos con gorras personalizadas riéndose', position: '50% 30%' },
]
const fotoHero = { width: 1400, widths: [640, 1000, 1400], quality: 72 }
// Las fotos del admin (PRI-413) que sirvan; si ninguna sirve, las de arriba.
const editedSlides = (
  await Promise.all(
    content.heroSlides.map(async ({ image_url, ...rest }) => {
      const foto = await fotoRemota(image_url, fotoHero)
      return foto && { ...rest, ...foto }
    }),
  )
).filter((s) => s !== null)
const heroSlides: Slide[] =
  editedSlides.length > 0
    ? editedSlides
    : await Promise.all(
        HERO.map(async ({ src, ...rest }) => {
          const img = await getImage({ src, format: 'webp', ...fotoHero })
          return { ...rest, src: img.src, srcSet: img.srcSet.attribute }
        }),
      )
const promoWithCover = promos.find((p) => p.banner_url || p.image_urls[0])
if (promoWithCover) {
  const cover = promoWithCover.banner_url || promoWithCover.image_urls[0]
  const img = await getImage({ src: cover, height: 900, format: 'webp', ...fotoHero })
  if (heroSlides.length > 1) heroSlides.splice(heroSlides.length - 1, 1)
  heroSlides.unshift({ src: img.src, srcSet: img.srcSet.attribute, alt: promoWithCover.title })
}
// "Qué hacemos": tarjetas del admin (2 a 6). Una foto que no sirve deja la tarjeta con la muestra neutra de ServiceCard.
const services = await Promise.all(
  content.services.map(async ({ image_url, image_alt, ...card }) => {
    const foto = image_url ? await fotoRemota(image_url, fotoServicio) : null
    return foto ? { ...card, image: { ...foto, alt: image_alt } } : card
  }),
)

const promoLinks = promos.map((p) => ({ title: p.title, href: `/promos/${p.slug}` }))

// "Ver todo" lleva a la primera categoría; desde ahí las pestañas llevan a las demás.
const catalogHref = categories[0] ? `/products/${categories[0].slug}` : '/'

const homeDescription =
  'Serflow en Cartagena: camisetas y gorras con estampado, DTF y bordado. Ven al taller en el Mercado Bazurto o escríbenos por WhatsApp.'

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'Serflow',
  description: homeDescription,
  image: 'https://serflowctg.netlify.app/favicon.svg',
  telephone: WHATSAPP_DISPLAY,
  email: EMAIL,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS ?? undefined,
    postalCode: POSTAL_CODE,
    addressLocality: 'Cartagena de Indias',
    addressRegion: 'Bolívar',
    addressCountry: 'CO',
  },
  openingHoursSpecification: HOURS_EDITED
    ? undefined
    : [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '08:00', closes: '18:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'], opens: '08:00', closes: '14:00' },
      ],
  areaServed: 'Cartagena, Colombia',
  url: 'https://serflowctg.netlify.app/',
  sameAs: [WHATSAPP_URL, ...SOCIAL.map((s) => s.url)],
}
---

<Layout title="Serflow: camisetas y gorras personalizadas en Cartagena" description={homeDescription}>
  <Fragment slot="head">
    <meta property="og:locale" content="es_CO" />
    <link rel="preload" as="image" href={heroSlides[0].src} imagesrcset={heroSlides[0].srcSet} imagesizes={HERO_SIZES} fetchpriority="high" />
    <script type="application/ld+json" set:html={jsonLd(localBusinessSchema)} />
  </Fragment>
  <Fragment slot="top">
    <PromoBar promos={promoLinks} />
  </Fragment>

  <HomePage
    slides={heroSlides}
    products={homeProducts}
    images={{
      estampado: estampado.src,
      dtf: dtf.src,
      bordado: bordado.src,
      personalizador,
      serviciosSrcSet: { estampado: estampado.srcSet.attribute, dtf: dtf.srcSet.attribute, bordado: bordado.srcSet.attribute },
    }}
    catalogHref={catalogHref}
    content={{ sections: content.sections, services, reasons: content.reasons }}
  />
  <PhotoModal />
</Layout>

<script>
  import '../scripts/photo-modal'
</script>
