---
import Layout from '../../layouts/Layout.astro'
import { PromosPage } from '../../components/promos/PromosPage'
import { getActivePromos } from '../../lib/products'
import { toPromoViews } from '../../lib/promo-view'

const promos = await toPromoViews(await getActivePromos())
---

<Layout title="Promos de hoy — Serflow" description="Promos vigentes de Serflow en Cartagena: camisetas y gorras personalizadas a buen precio. Pídelas por WhatsApp.">
  <PromosPage promos={promos} />
</Layout>
