---
import Layout from '../../layouts/Layout.astro'
import { PromoDetailPage } from '../../components/promos/PromoDetailPage'
import { getActivePromos } from '../../lib/products'
import { toPromoViews } from '../../lib/promo-view'
import { promoMensaje, type PromoView } from '../../lib/promos'

export async function getStaticPaths() {
  const promos = await toPromoViews(await getActivePromos())
  return promos.map((promo) => ({
    params: { slug: promo.slug },
    props: { promo, otras: promos.filter((p) => p.slug !== promo.slug) },
  }))
}

interface Props {
  promo: PromoView
  otras: PromoView[]
}

const { promo, otras } = Astro.props
---

<Layout title={`${promo.title} — Serflow`} description={promo.description ?? `Campaña ${promo.title} en Serflow Cartagena.`} whatsappText={promoMensaje(promo)}>
  <Fragment slot="head">
    {promo.cover && <link rel="preload" as="image" href={promo.cover.src} fetchpriority="high" />}
  </Fragment>
  <PromoDetailPage promo={promo} otras={otras} />
</Layout>
