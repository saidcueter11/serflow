---
import Layout from '../../layouts/Layout.astro'
import CatalogImage from '../../components/CatalogImage.astro'
import { WhatsAppIcon } from '../../components/icons/WhatsappIcon'
import { getActivePromos } from '../../lib/products'
import type { Promo } from '../../lib/types'

export async function getStaticPaths() {
  const promos = await getActivePromos()
  return promos.map((promo) => ({
    params: { slug: promo.slug },
    props: { promo },
  }))
}

interface Props {
  promo: Promo
}

const { promo } = Astro.props
const cover = promo.banner_url || promo.image_urls[0] || ''
const shots = promo.image_urls
const waText = `Hola! Me interesa la campana ${promo.title}:\n${Astro.url.href}`
---

<Layout title={`${promo.title} — Serflow`} description={`Campana ${promo.title} en Serflow Cartagena.`}>
  <div class="mt-6 mb-10 md:mb-14 max-w-xl w-full mx-auto flex flex-col gap-4 font-vend-sans section-padding">
    <a href="/" class="inline-flex items-center gap-2 text-accent">
      <span class="bg-accent text-primary rounded-full w-6 h-6 inline-flex items-center justify-center text-sm">
        ←
      </span>
      <span>Volver atras</span>
    </a>

    {
      cover && (
        <div class="relative aspect-[12/5] rounded-2xl overflow-hidden bg-surface">
          <CatalogImage
            src={cover}
            alt={promo.title}
            sizes="(min-width: 640px) 36rem, 100vw"
            widths={[640, 960, 1200]}
            preload
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/90 to-transparent" />
          <div class="absolute left-4 bottom-4">
            <p class="text-accent text-[10px] tracking-[0.2em] uppercase mb-1">Campana</p>
            <h1 class="font-titan text-2xl md:text-3xl text-white">{promo.title}</h1>
          </div>
        </div>
      )
    }

    {
      shots.length > 0 && (
        <div class="grid grid-cols-2 gap-3">
          {shots.map((src) => (
            <div class="aspect-square rounded-2xl overflow-hidden bg-surface">
              <CatalogImage
                src={src}
                alt={promo.title}
                sizes="50vw"
                widths={[320, 480, 640]}
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>
      )
    }

    <a
      href={`https://wa.me/+573156481243?text=${encodeURIComponent(waText)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center mx-auto w-full justify-center gap-3 bg-accent text-primary font-titan px-6 py-4 rounded-2xl text-lg"
    >
      <WhatsAppIcon className="w-5 h-5" />
      Preguntar por WhatsApp
    </a>
  </div>
</Layout>
