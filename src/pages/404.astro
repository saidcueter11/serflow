---
import Layout from '../layouts/Layout.astro'
import { NotFoundPage } from '../components/promos/NotFoundPage'
import { getActivePromos } from '../lib/products'
import { toPromoViews } from '../lib/promo-view'

const promos = await toPromoViews(await getActivePromos())
---

<Layout title="Página no encontrada — Serflow" description="La página que buscas no existe. Vuelve al inicio o escríbenos por WhatsApp.">
  <NotFoundPage promos={promos} />
</Layout>
