---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { getImage } from 'astro:assets'
import { Header, NAV_LINKS } from '../components/ui/Header'
import { getDisponibles } from '../lib/products'
import { Footer } from '../components/ui/Footer'
import { WhatsAppFab } from '../components/ui/WhatsAppFab'
import LogoImage from '../assets/LOGO SERFLOW.png'
import { OG_MARCA, absoluta } from '../lib/seo'

interface Props {
  title: string
  description?: string
  hideFooter?: boolean
  /** Mensaje prellenado del botón flotante de WhatsApp (p. ej. el de la promo que se está viendo). */
  whatsappText?: string
  /** Página escondida de los buscadores (p. ej. /personaliza hasta PRI-125). */
  /** Sin botón flotante: la página ya tiene su propio WhatsApp (visor del catálogo PRI-130, personalizador PRI-122). */
  hideFab?: boolean
  /** Imagen al compartir (PRI-525): la foto propia de la página. Sin ella, la de la marca. */
  ogImage?: { src: string; width?: number; height?: number; alt?: string }
  ogType?: 'website' | 'product'
}

const {
  title,
  description = 'Prendas personalizadas en Cartagena. Calidad que enamora, precios que te hacen volver. Contáctanos por WhatsApp.',
  hideFooter,
  whatsappText,
  hideFab,
  ogImage = OG_MARCA,
  ogType = 'website',
} = Astro.props

// PRI-123: si "Disponible ahora" no sale en la portada, su link tampoco.
const links = (await getDisponibles()).length > 0 ? NAV_LINKS : NAV_LINKS.filter((l) => l.href !== '/#disponible')
const canonicalUrl = Astro.url.toString()
const og = { ...ogImage, url: absoluta(ogImage.src), type: ogImage.src.endsWith('.png') ? 'image/png' : 'image/jpeg' }
const logo = await getImage({ src: LogoImage, width: 160, format: 'webp' })
---

<!doctype html>
<html lang="es-CO" class="bg-primary">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17160f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Serflow" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:secure_url" content={og.url} />
    <meta property="og:image:type" content={og.type} />
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={og.alt ?? title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />

    <title>{title}</title>
    <slot name="head" />

    <!-- Adaptive connection detection — degrades gracefully on slow networks -->
    <script is:inline>
      (function() {
        var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (!c) return;
        function update() {
          var t = c.effectiveType;
          var slow = c.saveData || t === 'slow-2g' || t === '2g';
          document.documentElement.dataset.connection = t;
          document.documentElement.classList.toggle('slow-connection', slow);
        }
        update();
        c.addEventListener('change', update);
      })();
    </script>
  </head>
  <body class="text-ink font-body">
    <div class="sf-nav-barra" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-primary focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Saltar al contenido principal
    </a>
    <div class="min-h-dvh h-full flex flex-col relative">
      <slot name="top" />
      <div class="sf-cabecera" transition:persist="cabecera">
        <Header logoSrc={logo.src} links={links} />
      </div>
      <div id="main-content" tabindex="-1">
        <slot />
      </div>
      {!hideFooter && <Footer logoSrc={logo.src} />}
      {!hideFab && <WhatsAppFab text={whatsappText} />}
    </div>
    <script>
      import '../scripts/movimiento'
    </script>
    <script is:inline>
      (function () {
        var PREFIX = 'serflow:scroll:'
        function categoryKey(path) {
          var clean = path.replace(/\/$/, '')
          return /^\/catalogo\/[^/]+$/.test(clean) ? clean : null
        }
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual'
        document.addEventListener('astro:before-preparation', function () {
          var key = categoryKey(location.pathname)
          if (key) sessionStorage.setItem(PREFIX + key, String(window.scrollY))
        })
        function restore() {
          var key = categoryKey(location.pathname)
          if (!key) return
          var raw = sessionStorage.getItem(PREFIX + key)
          if (raw == null) return
          var y = Number(raw)
          if (!y) return
          var html = document.documentElement
          var prev = html.style.scrollBehavior
          html.style.scrollBehavior = 'auto'
          window.scrollTo(0, y)
          html.style.scrollBehavior = prev
        }
        document.addEventListener('astro:after-swap', restore)
        document.addEventListener('astro:page-load', function () {
          restore()
          setTimeout(function () {
            restore()
            var key = categoryKey(location.pathname)
            if (key) sessionStorage.removeItem(PREFIX + key)
          }, 520)
        })
      })()
    </script>
  </body>
</html>
