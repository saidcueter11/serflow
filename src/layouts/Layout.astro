---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { getImage } from 'astro:assets'
import { Header } from '../components/ui/Header'
import { Footer } from '../components/ui/Footer'
import { WhatsAppFab } from '../components/ui/WhatsAppFab'
import LogoImage from '../assets/LOGO SERFLOW.png'

interface Props {
  title: string
  description?: string
  hideFooter?: boolean
  /** Mensaje prellenado del botón flotante de WhatsApp (p. ej. el de la promo que se está viendo). */
  whatsappText?: string
}

const {
  title,
  description = 'Prendas personalizadas en Cartagena. Calidad que enamora, precios que te hacen volver. Contáctanos por WhatsApp.',
  hideFooter,
  whatsappText,
} = Astro.props

const canonicalUrl = Astro.url.toString()
const logo = await getImage({ src: LogoImage, width: 160, format: 'webp' })
---

<!doctype html>
<html lang="es-CO" class="bg-primary">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Serflow" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <slot name="head" />

    <!-- Adaptive connection detection — degrades gracefully on slow networks -->
    <script is:inline>
      (function() {
        var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (!c) return;
        function update() {
          var t = c.effectiveType;
          var slow = c.saveData || t === 'slow-2g' || t === '2g';
          document.documentElement.dataset.connection = t;
          document.documentElement.classList.toggle('slow-connection', slow);
        }
        update();
        c.addEventListener('change', update);
      })();
    </script>
  </head>
  <body class="text-ink font-body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-primary focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Saltar al contenido principal
    </a>
    <div class="min-h-dvh h-full flex flex-col relative">
      <slot name="top" />
      <Header logoSrc={logo.src} transition:persist />
      <div id="main-content" tabindex="-1">
        <slot />
      </div>
      {!hideFooter && <Footer logoSrc={logo.src} />}
      <WhatsAppFab text={whatsappText} />
    </div>
    <script is:inline>
      (function () {
        var PREFIX = 'serflow:scroll:'
        function categoryKey(path) {
          var clean = path.replace(/\/$/, '')
          return /^\/products\/[^/]+$/.test(clean) ? clean : null
        }
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual'
        document.addEventListener('astro:before-preparation', function () {
          var key = categoryKey(location.pathname)
          if (key) sessionStorage.setItem(PREFIX + key, String(window.scrollY))
        })
        function restore() {
          var key = categoryKey(location.pathname)
          if (!key) return
          var raw = sessionStorage.getItem(PREFIX + key)
          if (raw == null) return
          var y = Number(raw)
          if (!y) return
          var html = document.documentElement
          var prev = html.style.scrollBehavior
          html.style.scrollBehavior = 'auto'
          window.scrollTo(0, y)
          html.style.scrollBehavior = prev
        }
        document.addEventListener('astro:after-swap', restore)
        document.addEventListener('astro:page-load', function () {
          restore()
          setTimeout(function () {
            restore()
            var key = categoryKey(location.pathname)
            if (key) sessionStorage.removeItem(PREFIX + key)
          }, 520)
        })
      })()
    </script>
  </body>
</html>
