---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WhatsAppFAB from '../components/WhatsAppFAB.astro'

interface Props {
  title: string
  description?: string
  hideFooter?: boolean
}

const {
  title,
  description = 'Prendas personalizadas en Cartagena. Calidad que enamora, precios que te hacen volver. Contáctanos por WhatsApp.',
  hideFooter,
} = Astro.props

const canonicalUrl = Astro.url.toString()
---

<!doctype html>
<html lang="es-CO" class="bg-primary">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Serflow" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <slot name="head" />

    <!-- Adaptive connection detection — degrades gracefully on slow networks -->
    <script is:inline>
      (function() {
        var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (!c) return;
        function update() {
          var t = c.effectiveType;
          var slow = c.saveData || t === 'slow-2g' || t === '2g';
          document.documentElement.dataset.connection = t;
          document.documentElement.classList.toggle('slow-connection', slow);
        }
        update();
        c.addEventListener('change', update);
      })();
    </script>
  </head>
  <body class="text-white font-vend-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-primary focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Saltar al contenido principal
    </a>
    <div class="min-h-dvh h-full flex flex-col relative">
      <Header transition:persist />
      <div id="main-content" tabindex="-1">
        <slot />
      </div>
      {!hideFooter && <Footer />}
      <WhatsAppFAB />
    </div>
  </body>
</html>
