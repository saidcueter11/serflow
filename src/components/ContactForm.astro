---
import { WhatsAppIcon } from './icons/WhatsappIcon'
---

<form id="contactForm" class="flex flex-col gap-5 w-full font-vend-sans">
  <div class="flex flex-col gap-1.5">
    <label for="fullName" class="text-muted text-sm">Nombre</label>
    <input
      class="bg-primary-light border border-primary-lighter focus:border-accent/60 rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted/40 outline-none transition-colors"
      type="text"
      id="fullName"
      name="fullName"
      placeholder="Tu nombre"
      required
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="phoneNumber" class="text-muted text-sm">Número de teléfono</label>
    <input
      class="bg-primary-light border border-primary-lighter focus:border-accent/60 rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted/40 outline-none transition-colors"
      type="tel"
      id="phoneNumber"
      name="phoneNumber"
      placeholder="+57 300 000 0000"
      required
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="message" class="text-muted text-sm">Mensaje</label>
    <textarea
      class="bg-primary-light border border-primary-lighter focus:border-accent/60 rounded-xl px-4 py-3 text-white text-sm placeholder:text-muted/40 outline-none transition-colors resize-none"
      name="message"
      id="message"
      rows="4"
      placeholder="¿En qué podemos ayudarte?"
      required></textarea>
  </div>

  <button
    type="submit"
    class="btn-primary w-fit text-sm mt-1"
  >
    <WhatsAppIcon className="size-4" />
    Enviar por WhatsApp
  </button>
</form>

<script>
  function initContactForm() {
    const form = document.getElementById('contactForm') as HTMLFormElement

    if (!form) return

    form.addEventListener('submit', (e) => {
      e.preventDefault()

      const formData = new FormData(form)
      const name = formData.get('fullName') as string
      const phone = formData.get('phoneNumber') as string
      const message = formData.get('message') as string

      const localPhone = '+573156481243'
      const sanitizedPhone = phone.replace(/\D/g, '')

      const text = `
📩 Nuevo servicio

👤 Nombre: ${name}
📞 Número de teléfono: ${sanitizedPhone}
📝 Mensaje:
${message}
      `.trim()

      const url = `https://wa.me/${localPhone}?text=${encodeURIComponent(text)}`
      window.open(url, '_blank')

      // Optional: Reset form after submission
      form.reset()
    })
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initContactForm)
</script>
