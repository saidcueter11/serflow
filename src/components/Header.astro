---
import { MenuIcon } from './icons/MenuIcon'
import { Image } from 'astro:assets'
import Logo from '../assets/LOGO SERFLOW.png'
---

<header
  class="flex justify-between sticky top-0 z-50 items-end px-8 py-3 mx-auto w-full bg-primary/70 backdrop-blur-sm"
>
  <a href="/" data-astro-prefetch>
    <Image
      alt=""
      src={Logo}
      fetchpriority="high"
      class="w-24 md:w-36"
      transition:persist
    />
  </a>

  <button
    id="menuToggle"
    class="sm:hidden active:scale-110"
    aria-label="Toggle menu"
  >
    <MenuIcon />
  </button>

  <nav
    class="hidden sm:flex gap-6 font-vend-sans prose prose-invert prose-a:no-underline text-lg"
  >
    <a
      href="/"
      data-astro-prefetch
      class="nav-link underline-hover"
      data-path="/"
    >
      Inicio
    </a>

    <a
      href="/products/miTierraQuerida"
      data-astro-prefetch
      class="nav-link underline-hover"
      data-path="/products"
    >
      Products
    </a>

    <a
      href="/nuestroEquipo"
      data-astro-prefetch
      class="nav-link underline-hover"
      data-path="/nuestroEquipo"
    >
      Nuestro equipo
    </a>

    <a
      href="/sugerencias"
      data-astro-prefetch
      class="nav-link underline-hover"
      data-path="/sugerencias"
    >
      Sugerencias
    </a>
  </nav>
</header>

<aside
  id="sideMenu"
  class="translate-x-full transition duration-300 fixed w-full z-50 inset-0 h-full flex flex-col items-end text-xl"
>
  <div class="bg-secondary h-full p-4 w-3/5">
    <button id="menuClose" aria-label="Close menu">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="flex flex-col mt-4 gap-8 font-vend-sans font-semibold items-center"
    >
      <a href="/" data-astro-prefetch class="mobile-nav-link"> Inicio </a>
      <a
        href="/products/miTierraQuerida"
        data-astro-prefetch
        class="mobile-nav-link"
      >
        Productos
      </a>
      <a href="/nuestroEquipo" data-astro-prefetch class="mobile-nav-link">
        Nuestro equipo
      </a>
      <a href="/sugerencias" data-astro-prefetch class="mobile-nav-link">
        Sugerencias
      </a>
    </div>
  </div>
</aside>

<script>
  function initHeader() {
    const menuToggle = document.getElementById('menuToggle')
    const menuClose = document.getElementById('menuClose')
    const sideMenu = document.getElementById('sideMenu')
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link')
    const navLinks = document.querySelectorAll('.nav-link')

    // Update active nav link based on current path
    function updateActiveLink() {
      const currentPath = window.location.pathname

      navLinks.forEach((link) => {
        const linkPath = link.getAttribute('data-path')
        if (linkPath === '/' && currentPath === '/') {
          link.classList.add('after:scale-x-100', 'after:origin-bottom')
        } else if (linkPath !== '/' && currentPath.startsWith(linkPath!)) {
          link.classList.add('after:scale-x-100', 'after:origin-bottom')
        } else {
          link.classList.remove('after:scale-x-100', 'after:origin-bottom')
        }
      })
    }

    // Toggle side menu
    function toggleMenu(isOpen: boolean) {
      if (isOpen) {
        sideMenu?.classList.remove('translate-x-full')
        sideMenu?.classList.add('backdrop-blur-sm')
      } else {
        sideMenu?.classList.add('translate-x-full')
        sideMenu?.classList.remove('backdrop-blur-sm')
      }
    }

    // Event listeners
    menuToggle?.addEventListener('click', () => toggleMenu(true))
    menuClose?.addEventListener('click', () => toggleMenu(false))

    // Close menu when clicking outside
    sideMenu?.addEventListener('click', (e) => {
      if (e.target === sideMenu) {
        toggleMenu(false)
      }
    })

    // Close menu when clicking mobile nav links
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false))
    })

    // Update active link on page load and navigation
    updateActiveLink()
    document.addEventListener('astro:after-swap', updateActiveLink)
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initHeader)
</script>
