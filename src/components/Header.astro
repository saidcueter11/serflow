---
import { MenuIcon } from './icons/MenuIcon'
import { WhatsAppIcon } from './icons/WhatsappIcon'
import { Image } from 'astro:assets'
import Logo from '../assets/LOGO SERFLOW.png'
---

<header
  class="glass fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="mainHeader"
>
  <div class="max-w-6xl mx-auto flex justify-between items-center px-6 md:px-12 py-3">
    <a href="/" class="shrink-0">
      <Image
        alt="Serflow"
        src={Logo}
        fetchpriority="high"
        class="w-20 md:w-28 transition-all duration-300"
        transition:persist
      />
    </a>

    <button
      id="menuToggle"
      class="md:hidden active:scale-110 text-muted hover:text-accent transition-colors"
      aria-label="Toggle menu"
      aria-controls="sideMenu"
      aria-expanded="false"
    >
      <MenuIcon />
    </button>

    <nav
      class="hidden md:flex items-center gap-8 font-vend-sans text-sm tracking-wide"
    >
      <a
        href="/"
        class="nav-link text-muted hover:text-white transition-colors underline-hover"
        data-path="/"
      >
        Inicio
      </a>

      <a
        href="/products/mi-tierra-querida"
        class="nav-link text-muted hover:text-white transition-colors underline-hover"
        data-path="/products"
      >
        Productos
      </a>

      <a
        href="/#ubicacion"
        class="nav-link text-muted hover:text-white transition-colors underline-hover"
        data-path="/#ubicacion"
      >
        Ubicación
      </a>

      <a
        href="/#contacto"
        class="nav-link text-muted hover:text-white transition-colors underline-hover"
        data-path="/#contacto"
      >
        Contacto
      </a>

      <a
        href="https://wa.me/573156481243?text=Hola!%20Quiero%20más%20información"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-sm !py-2 !px-5"
      >
        <WhatsAppIcon className="size-4" />
        Escríbenos
      </a>
    </nav>
  </div>
</header>

<!-- Spacer so content doesn't hide behind fixed header -->
<div class="h-16 md:h-18"></div>

<aside
  id="sideMenu"
  class="translate-x-full transition duration-300 fixed w-full z-50 inset-0 h-full flex flex-col items-end"
  aria-hidden="true"
>
  <div
    class="bg-surface h-full p-6 w-4/5 max-w-xs flex flex-col shadow-2xl shadow-black/50"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <button id="menuClose" aria-label="Close menu" class="self-end text-muted hover:text-white transition-colors">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div
      class="flex flex-col mt-8 gap-6 font-vend-sans items-start"
    >
      <a href="/" class="mobile-nav-link text-muted hover:text-accent transition-colors text-lg">
        Inicio
      </a>
      <a
        href="/products/mi-tierra-querida"
        class="mobile-nav-link text-muted hover:text-accent transition-colors text-lg"
      >
        Productos
      </a>
      <a href="/#ubicacion" class="mobile-nav-link text-muted hover:text-accent transition-colors text-lg">
        Ubicación
      </a>
      <a href="/#contacto" class="mobile-nav-link text-muted hover:text-accent transition-colors text-lg">
        Contacto
      </a>
    </div>

    <!-- Mobile WhatsApp CTA -->
    <a
      href="https://wa.me/573156481243?text=Hola!%20Quiero%20más%20información"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary mt-auto mb-8 w-full text-center text-sm"
    >
      <WhatsAppIcon className="size-5" />
      Escríbenos por WhatsApp
    </a>
  </div>
</aside>

<script>
  function initHeader() {
    const menuToggle = document.getElementById('menuToggle')
    const menuClose = document.getElementById('menuClose')
    const sideMenu = document.getElementById('sideMenu')
    const sideMenuPanel = sideMenu?.firstElementChild as HTMLElement | null
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link')
    const navLinks = document.querySelectorAll('.nav-link')
    const mainHeader = document.getElementById('mainHeader')

    if (!mainHeader || mainHeader.dataset.initialized === 'true') return
    mainHeader.dataset.initialized = 'true'

    let lastFocusedElement: HTMLElement | null = null

    function getFocusableElements() {
      if (!sideMenuPanel) return []
      return Array.from(
        sideMenuPanel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])',
        ),
      )
    }

    function handleFocusTrap(e: KeyboardEvent) {
      if (e.key !== 'Tab') return
      const focusableElements = getFocusableElements()
      if (focusableElements.length === 0) return

      const firstFocusable = focusableElements[0]
      const lastFocusable = focusableElements[focusableElements.length - 1]

      if (e.shiftKey && document.activeElement === firstFocusable) {
        e.preventDefault()
        lastFocusable.focus()
      } else if (!e.shiftKey && document.activeElement === lastFocusable) {
        e.preventDefault()
        firstFocusable.focus()
      }
    }

    function handleEscape(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        toggleMenu(false)
      }
    }

    // Update active nav link based on current path
    function updateActiveLink() {
      const currentPath = window.location.pathname

      navLinks.forEach((link) => {
        const linkPath = link.getAttribute('data-path')
        if (linkPath === '/' && currentPath === '/') {
          link.classList.add('after:scale-x-100', 'after:origin-bottom', 'text-white')
          link.classList.remove('text-muted')
        } else if (linkPath !== '/' && linkPath !== '/#ubicacion' && linkPath !== '/#contacto' && currentPath.startsWith(linkPath!)) {
          link.classList.add('after:scale-x-100', 'after:origin-bottom', 'text-white')
          link.classList.remove('text-muted')
        } else {
          link.classList.remove('after:scale-x-100', 'after:origin-bottom', 'text-white')
          link.classList.add('text-muted')
        }
      })
    }

    // Toggle side menu
    function toggleMenu(isOpen: boolean) {
      if (isOpen) {
        lastFocusedElement = document.activeElement as HTMLElement
        sideMenu?.classList.remove('translate-x-full')
        sideMenu?.classList.add('backdrop-blur-sm', 'bg-black/30')
        sideMenu?.setAttribute('aria-hidden', 'false')
        menuToggle?.setAttribute('aria-expanded', 'true')

        const focusableElements = getFocusableElements()
        focusableElements[0]?.focus()

        document.addEventListener('keydown', handleEscape)
        document.addEventListener('keydown', handleFocusTrap)
      } else {
        sideMenu?.classList.add('translate-x-full')
        sideMenu?.classList.remove('backdrop-blur-sm', 'bg-black/30')
        sideMenu?.setAttribute('aria-hidden', 'true')
        menuToggle?.setAttribute('aria-expanded', 'false')

        document.removeEventListener('keydown', handleEscape)
        document.removeEventListener('keydown', handleFocusTrap)
        lastFocusedElement?.focus()
      }
    }

    // Event listeners
    menuToggle?.addEventListener('click', () => toggleMenu(true))
    menuClose?.addEventListener('click', () => toggleMenu(false))

    // Close menu when clicking outside
    sideMenu?.addEventListener('click', (e) => {
      if (e.target === sideMenu) {
        toggleMenu(false)
      }
    })

    // Close menu when clicking mobile nav links
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false))
    })

    // Update active link on page load and navigation
    updateActiveLink()
    document.addEventListener('astro:after-swap', updateActiveLink)
  }

  // Initialize on page load
  document.addEventListener('astro:page-load', initHeader)
</script>
