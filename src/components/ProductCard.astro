---
import type { Categories } from '../mocks/mockProducts'
import { Image } from 'astro:assets'

interface Props {
  id: number
  imagePath: string
  category: Categories
  altText?: string
  preload?: boolean
}

const { id, imagePath, category, altText, preload } = Astro.props

// Dynamically import only the image we need
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.webp',
)
const imageSrc = await images[`../assets/images/${imagePath}`]()
---

<div class="group">
  <a
    href={`/products/${category}/${id}`}
    class="block rounded-2xl overflow-hidden bg-surface border border-white/5 hover:border-accent/20 transition-all duration-300"
    style="border-radius: 1rem; overflow: hidden;"
  >
    <div class="relative overflow-hidden aspect-square rounded-2xl" style="border-radius: 1rem;">
      <!-- Loading skeleton -->
      <div
        class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-light via-primary-lighter to-primary-light bg-[length:200%_100%] animate-[shimmer_1.5s_ease-in-out_infinite]"
        data-image-id={id}
      >
      </div>

      <!-- Actual image -->
      <Image
        src={imageSrc.default}
        alt={altText ?? `${category} ${id}`}
        format="webp"
        widths={[320, 640]}
        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 22vw"
        fetchpriority={preload ? 'high' : 'auto'}
        loading={preload ? 'eager' : 'lazy'}
        decoding="async"
        quality={78}
        class="w-full h-full object-cover object-center relative z-10 rounded-2xl animate-[fadeIn_0.3s_ease-in] group-hover:scale-105 transition-transform duration-500"
        transition:name={`product-image-${id}`}
        onload={`document.querySelector('[data-image-id="${id}"]')?.classList.add('hidden')`}
      />

      <!-- Hover overlay with CTA -->
      <div class="absolute inset-0 z-20 rounded-2xl bg-primary/0 group-hover:bg-primary/40 transition-all duration-300 flex items-end justify-center pb-4 opacity-0 group-hover:opacity-100">
        <span class="bg-accent text-primary text-xs font-vend-sans font-semibold px-4 py-2 rounded-full translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
          Ver detalle
        </span>
      </div>
    </div>
  </a>
</div>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Hide skeleton when images load (for browsers that don't support onload attribute)
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[loading]')
    images.forEach((img) => {
      if (img.complete) {
        const skeleton = img.closest('a')?.querySelector('[data-image-id]')
        skeleton?.classList.add('hidden')
      } else {
        img.addEventListener('load', () => {
          const skeleton = img.closest('a')?.querySelector('[data-image-id]')
          skeleton?.classList.add('hidden')
        })
      }
    })
  })
</script>
