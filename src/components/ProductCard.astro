---
import type { Categories } from '../mocks/mockProducts'
import { Image } from 'astro:assets'

interface Props {
  id: number
  imagePath: string
  category: Categories
  preload?: boolean
}

const { id, imagePath, category, preload } = Astro.props

// Dynamically import only the image we need
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.webp',
)
const imageSrc = await images[`../assets/images/${imagePath}`]()
---

<div class="flex flex-col gap-3 prose prose-img:m-0 prose-p:m-0 prose-invert">
  <div class="flex flex-col gap-2">
    <a
      href={`/products/${category}/${id}`}
      data-astro-prefetch
      class="block transition-transform duration-300 hover:scale-110 hover:z-30 drop-shadow-md hover:drop-shadow-primary hover:rotate-2 active:scale-110 active:rotate-2 active:drop-shadow-primary active:z-30"
    >
      <div class="relative overflow-hidden rounded-lg bg-gray-800">
        <!-- Loading skeleton -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-gray-700 via-gray-600 to-gray-700 bg-[length:200%_100%] animate-[shimmer_1.5s_ease-in-out_infinite]"
          data-image-id={id}
        >
        </div>

        <!-- Actual image -->
        <Image
          src={imageSrc.default}
          alt={category}
          format="webp"
          widths={[320, 640]}
          sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 22vw"
          fetchpriority={preload ? 'high' : 'auto'}
          loading={preload ? 'eager' : 'lazy'}
          decoding="async"
          quality={75}
          class="w-full h-full object-cover rounded-lg object-center relative z-10 animate-[fadeIn_0.3s_ease-in]"
          transition:name={`product-image-${id}`}
          onload={`document.querySelector('[data-image-id="${id}"]')?.classList.add('hidden')`}
        />
      </div>
    </a>
  </div>
</div>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Hide skeleton when images load (for browsers that don't support onload attribute)
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[loading]')
    images.forEach((img) => {
      if (img.complete) {
        const skeleton = img.closest('a')?.querySelector('[data-image-id]')
        skeleton?.classList.add('hidden')
      } else {
        img.addEventListener('load', () => {
          const skeleton = img.closest('a')?.querySelector('[data-image-id]')
          skeleton?.classList.add('hidden')
        })
      }
    })
  })
</script>
