---
import CatalogImage from './CatalogImage.astro'

interface Props {
  slug: string
  imageUrl: string
  categorySlug: string
  altText?: string
  preload?: boolean
  index?: number
}

const { slug, imageUrl, categorySlug, altText, preload, index = 99 } = Astro.props
const stagger = index < 6 ? index : undefined
---

<div
  class:list={['group', { 'catalog-in': stagger !== undefined }]}
  style={stagger !== undefined ? `--stagger: ${stagger}` : undefined}
>
  <a
    href={`/products/${categorySlug}/${slug}`}
    aria-label={altText ?? 'Ver prenda'}
    class="block rounded-2xl overflow-hidden bg-surface ring-1 ring-white/20 transition-[box-shadow,transform] duration-300 ease-out active:scale-[1.02] [@media(hover:hover)]:hover:ring-white/40 [@media(hover:hover)]:hover:scale-[1.02]"
  >
    <div class="relative overflow-hidden aspect-square rounded-2xl">
      <!-- Loading skeleton -->
      <div
        class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-light via-primary-lighter to-primary-light bg-[length:200%_100%] animate-[shimmer_1.5s_ease-in-out_infinite]"
        data-image-id={slug}
      >
      </div>

      {
        imageUrl && (
          <CatalogImage
            src={imageUrl}
            alt={altText ?? slug}
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
            widths={[320, 480, 640]}
            preload={preload}
            class="w-full h-full object-cover object-center relative z-10 rounded-2xl"
            transitionName={`product-image-${slug}`}
          />
        )
      }

      <span
        class="absolute inset-0 z-20 rounded-2xl bg-black/0 [@media(hover:hover)]:group-hover:bg-black/20 transition-colors duration-300 pointer-events-none"
        aria-hidden="true"
      />
      <span
        class="absolute bottom-2 right-2 z-30 flex h-7 w-7 items-center justify-center rounded-full bg-black/55 text-white pointer-events-none"
        aria-hidden="true"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </a>
</div>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

</style>

<script>
  // Hide skeleton when images load (for browsers that don't support onload attribute)
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[loading]')
    images.forEach((img) => {
      if (img.complete) {
        const skeleton = img.closest('a')?.querySelector('[data-image-id]')
        skeleton?.classList.add('hidden')
      } else {
        img.addEventListener('load', () => {
          const skeleton = img.closest('a')?.querySelector('[data-image-id]')
          skeleton?.classList.add('hidden')
        })
      }
    })
  })
</script>
