---
import CatalogImage from './CatalogImage.astro'

interface Props {
  slug: string
  imageUrl: string
  categorySlug: string
  altText?: string
  preload?: boolean
  index?: number
}

const { slug, imageUrl, categorySlug, altText, preload, index = 99 } = Astro.props
const stagger = index < 6 ? index : undefined
const ratios = ['aspect-[3/4]', 'aspect-square', 'aspect-[4/5]'] as const
const ratio = ratios[index % 3]
---

<div
  class:list={['group', { 'catalog-in': stagger !== undefined }]}
  style={stagger !== undefined ? `--stagger: ${stagger}` : undefined}
>
  <a
    href={`/products/${categorySlug}/${slug}`}
    aria-label={altText ?? 'Ver prenda'}
    class="block rounded-2xl overflow-hidden bg-surface shadow-[0_8px_22px_rgba(0,0,0,0.4)] transition-transform duration-300 ease-out active:scale-[0.98]"
  >
    <div class:list={['relative overflow-hidden rounded-2xl', ratio]}>
      <!-- Loading skeleton -->
      <div
        class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-light via-primary-lighter to-primary-light bg-[length:200%_100%] animate-[shimmer_1.5s_ease-in-out_infinite]"
        data-image-id={slug}
      >
      </div>

      {
        imageUrl && (
          <CatalogImage
            src={imageUrl}
            alt={altText ?? slug}
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
            widths={[320, 480, 640]}
            preload={preload}
            class="w-full h-full object-cover object-center relative z-10 rounded-2xl"
            transitionName={`product-image-${slug}`}
          />
        )
      }


    </div>
  </a>
</div>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

</style>

<script>
  // Hide skeleton when images load (for browsers that don't support onload attribute)
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[loading]')
    images.forEach((img) => {
      if (img.complete) {
        const skeleton = img.closest('a')?.querySelector('[data-image-id]')
        skeleton?.classList.add('hidden')
      } else {
        img.addEventListener('load', () => {
          const skeleton = img.closest('a')?.querySelector('[data-image-id]')
          skeleton?.classList.add('hidden')
        })
      }
    })
  })
</script>
