---
import CatalogImage from './CatalogImage.astro'

interface Props {
  slug: string
  imageUrl: string
  categorySlug: string
  altText?: string
  preload?: boolean
  index?: number
}

const { slug, imageUrl, categorySlug, altText, preload, index = 99 } = Astro.props
const stagger = index < 6 ? index : undefined
---

<div
  class:list={['group', { 'catalog-in': stagger !== undefined }]}
  style={stagger !== undefined ? `--stagger: ${stagger}` : undefined}
>
  <a
    href={`/products/${categorySlug}/${slug}`}
    class="block rounded-2xl overflow-hidden bg-surface border border-white/5 transition-[border-color,transform] duration-200 ease-out active:scale-[1.02] [@media(hover:hover)]:hover:border-accent/20 [@media(hover:hover)]:hover:scale-[1.02]"
  >
    <div class="relative overflow-hidden aspect-square rounded-2xl">
      <!-- Loading skeleton -->
      <div
        class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-light via-primary-lighter to-primary-light bg-[length:200%_100%] animate-[shimmer_1.5s_ease-in-out_infinite]"
        data-image-id={slug}
      >
      </div>

      {
        imageUrl && (
          <CatalogImage
            src={imageUrl}
            alt={altText ?? slug}
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
            widths={[320, 480, 640]}
            preload={preload}
            class="w-full h-full object-cover object-center relative z-10 rounded-2xl"
            transitionName={`product-image-${slug}`}
          />
        )
      }

      <div class="absolute inset-0 z-20 rounded-2xl hidden [@media(hover:hover)]:flex items-end justify-center pb-4 bg-primary/0 opacity-0 [@media(hover:hover)]:group-hover:bg-primary/40 [@media(hover:hover)]:group-hover:opacity-100 transition-[opacity,background-color] duration-200">
        <span class="bg-accent text-primary text-xs font-vend-sans font-semibold px-4 py-2 rounded-full">
          Ver detalle
        </span>
      </div>
    </div>
  </a>
</div>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

</style>

<script>
  // Hide skeleton when images load (for browsers that don't support onload attribute)
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('img[loading]')
    images.forEach((img) => {
      if (img.complete) {
        const skeleton = img.closest('a')?.querySelector('[data-image-id]')
        skeleton?.classList.add('hidden')
      } else {
        img.addEventListener('load', () => {
          const skeleton = img.closest('a')?.querySelector('[data-image-id]')
          skeleton?.classList.add('hidden')
        })
      }
    })
  })
</script>
