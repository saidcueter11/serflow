---
interface Props {
  text: string
  align?: 'center' | 'left'
}

const { text, align = 'center' } = Astro.props
---

<div class:list={['flex flex-col gap-2', { 'items-center': align === 'center', 'items-start': align === 'left' }]}>
  <div class="h-0.5 w-10 bg-accent rounded-full"></div>
  <h2 class:list={['text-2xl md:text-3xl font-titan font-normal text-white', { 'text-center': align === 'center' }]}>
    {text}
  </h2>
</div>
