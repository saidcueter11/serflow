---
import { getCategoriesWithCounts } from '../lib/products'
import CatalogImage from './CatalogImage.astro'

const categories = await getCategoriesWithCounts()
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
  {
    categories.map((cat, index) => (
      <a
        href={`/products/${cat.slug}`}
        class="group catalog-in relative rounded-2xl overflow-hidden aspect-[3/4] block ring-1 ring-accent/30 active:scale-[1.02] [@media(hover:hover)]:hover:scale-[1.02] transition-transform duration-300 ease-out"
        style={`--stagger: ${Math.min(index, 5)}`}
      >
        {cat.image_url ? (
          <CatalogImage
            src={cat.image_url}
            alt={cat.label}
            sizes="(min-width: 1024px) 20vw, (min-width: 768px) 33vw, 50vw"
            widths={[320, 480, 640]}
            class="absolute inset-0 w-full h-full object-cover object-center"
          />
        ) : (
          <div class="absolute inset-0 bg-zinc-800" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/30 to-transparent" />
        <div class="absolute inset-0 bg-accent/0 [@media(hover:hover)]:group-hover:bg-accent/10 transition-colors duration-200" />
        <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-between gap-2">
          <div>
            <h3 class="font-titan font-normal text-white text-base md:text-lg leading-tight">
              {cat.label}
            </h3>
            <span class="text-muted font-vend-sans text-xs mt-1 block">
              {cat.product_count} productos
            </span>
          </div>
          <span
            class="shrink-0 w-8 h-8 rounded-full bg-accent text-primary flex items-center justify-center"
            aria-hidden="true"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </a>
    ))
  }
</div>
