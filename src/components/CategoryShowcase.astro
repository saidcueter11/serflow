---
import { getCategoriesWithCounts } from '../lib/products'
import CatalogImage from './CatalogImage.astro'

const categories = await getCategoriesWithCounts()
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
  {
    categories.map((cat, index) => (
      <a
        href={`/products/${cat.slug}`}
        class="group catalog-in relative rounded-2xl overflow-hidden aspect-[3/4] block ring-1 ring-white/20 active:scale-[1.02] [@media(hover:hover)]:hover:ring-white/40 [@media(hover:hover)]:hover:scale-[1.02] transition-[transform,box-shadow] duration-300 ease-out"
        style={`--stagger: ${Math.min(index, 5)}`}
      >
        {cat.image_url ? (
          <CatalogImage
            src={cat.image_url}
            alt={cat.label}
            sizes="(min-width: 1024px) 20vw, (min-width: 768px) 33vw, 50vw"
            widths={[320, 480, 640]}
            class="absolute inset-0 w-full h-full object-cover object-center"
          />
        ) : (
          <div class="absolute inset-0 bg-zinc-800" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/30 to-transparent" />
        <div class="absolute inset-0 bg-accent/0 [@media(hover:hover)]:group-hover:bg-accent/10 transition-colors duration-200" />
        <div class="absolute bottom-0 left-0 right-0 p-4">
          <h3 class="font-titan font-normal text-white text-base md:text-lg leading-tight">
            {cat.label}
          </h3>
          <span class="text-muted font-vend-sans text-xs mt-1 block">
            {cat.product_count} productos
          </span>
        </div>
      </a>
    ))
  }
</div>
