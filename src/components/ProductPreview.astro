---
import { WhatsAppIcon } from './icons/WhatsappIcon'
import CatalogImage from './CatalogImage.astro'

interface Props {
  images: string[]
  mainImage: string
  alt: string
  slug: string
  productName?: string
}

const { images, alt, slug, productName } = Astro.props
const shots = images.filter(Boolean)
const ratios = ['aspect-[3/4]', 'aspect-[4/3]', 'aspect-[3/4]']
---

<div class="flex flex-col gap-3 w-full" data-product-name={productName}>
  {
    shots.map((image, i) => (
      <div
        class:list={[
          'overflow-hidden rounded-2xl bg-surface shadow-[0_10px_28px_rgba(0,0,0,0.4)]',
          ratios[i % ratios.length],
        ]}
      >
        <CatalogImage
          src={image}
          alt={`${alt} - imagen ${i + 1} de ${shots.length}`}
          sizes="(min-width: 640px) 36rem, 100vw"
          widths={[640, 960, 1200]}
          preload={i === 0}
          class="w-full h-full object-cover object-center"
          transitionName={i === 0 ? `product-image-${slug}` : undefined}
        />
      </div>
    ))
  }

  <button
    data-whatsapp
    class="flex items-center mx-auto w-full justify-center gap-3 bg-accent text-primary hover:bg-accent/90 active:bg-accent/80 cursor-pointer font-titan px-6 py-4 rounded-2xl font-normal transition-[transform,background-color] duration-300 shadow-lg shadow-accent/10 active:scale-[0.98] text-lg mt-1"
    aria-label="Contactar por WhatsApp"
  >
    <WhatsAppIcon className="w-5 h-5" />
    Preguntar por WhatsApp
  </button>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-whatsapp]').forEach((btn) => {
      if (btn.dataset.ready === 'true') return
      btn.dataset.ready = 'true'
      btn.addEventListener('click', () => {
        const text = `Hola! Me interesa este producto:\n${location.href}`
        window.open(
          `https://wa.me/+573156481243?text=${encodeURIComponent(text)}`,
          '_blank',
          'noopener,noreferrer',
        )
      })
    })
  })
</script>
