---
import { Image } from 'astro:assets'

interface Props {
  src: string
  alt: string
  sizes: string
  widths?: number[]
  preload?: boolean
  class?: string
}

const {
  src,
  alt,
  sizes,
  widths = [320, 640, 960],
  preload = false,
  class: className,
} = Astro.props
---

<Image
  src={src}
  alt={alt}
  inferSize
  widths={widths}
  sizes={sizes}
  quality={75}
  loading={preload ? 'eager' : 'lazy'}
  fetchpriority={preload ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
