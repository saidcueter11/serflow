---
import {
  getCategories,
  getProductsByCategory,
  getCategoryBySlug,
} from '../lib/products'
import ProductCard from './ProductCard.astro'

interface Props {
  currentCategorySlug: string
}

const { currentCategorySlug } = Astro.props

const [categories, products, currentCategory] = await Promise.all([
  getCategories(),
  getProductsByCategory(currentCategorySlug),
  getCategoryBySlug(currentCategorySlug),
])

const categoryLabel = currentCategory?.label ?? currentCategorySlug
const categoryImage = currentCategory?.image_url
---

<!-- Hero banner -->
<div class="relative w-full rounded-2xl overflow-hidden" transition:persist={currentCategorySlug}>
  {categoryImage ? (
    <img
      class="w-full h-48 md:h-56 object-cover object-center"
      src={categoryImage}
      fetchpriority="high"
      alt={`Colección ${categoryLabel} de Serflow`}
    />
  ) : (
    <div class="w-full h-48 md:h-56 bg-zinc-800" />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
    <h1 class="text-3xl md:text-4xl font-titan font-normal text-white">
      {categoryLabel}
    </h1>
    <p class="text-muted font-vend-sans text-sm mt-1">
      {products.length} productos disponibles
    </p>
  </div>
</div>

<!-- Category tabs -->
<div class="flex gap-2 text-sm flex-wrap justify-start mt-6">
  {
    categories.map((category) => (
      <a
        href={`/products/${category.slug}`}
        class={`cursor-pointer rounded-full px-5 py-2 no-underline font-vend-sans font-medium transition-all duration-300 text-sm ${
          currentCategorySlug === category.slug
            ? 'bg-accent text-primary'
            : 'bg-surface text-muted hover:text-white border border-primary-lighter hover:border-accent/30'
        }`}
      >
        {category.label}
      </a>
    ))
  }
</div>

<!-- Product grid -->
{
  products.length === 0 ? (
    <div class="mt-8 rounded-2xl border border-primary-lighter bg-surface p-8 text-center">
      <p class="text-muted font-vend-sans">
        No hay productos disponibles en esta categoría por ahora.
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4 mt-8">
      {products.map((product, index) => (
        <ProductCard
          slug={product.slug}
          imageUrl={product.image_urls[0] ?? ''}
          categorySlug={currentCategorySlug}
          altText={`${categoryLabel} — ${product.name}`}
          preload={index < 4}
        />
      ))}
    </div>
  )
}
