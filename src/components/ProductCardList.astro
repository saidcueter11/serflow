---
import {
  Categories,
  CategoryLabels,
  getProductsByCategory,
} from '../mocks/mockProducts'
import ProductCard from './ProductCard.astro'
import miTierraQuerida from '../assets/miTierraQuerida.jpg'
import baseball from '../assets/beisbol.jpg'
import kids from '../assets/kids.png'
import basketball from '../assets/basketball.jpg'
import moda from '../assets/images/moda/moda1.webp'
import { Image } from 'astro:assets'

interface Props {
  currentCategory: Categories
}

const { currentCategory } = Astro.props as Props

const categoryImages: Record<Categories, ImageMetadata> = {
  [Categories.miTierraQuerida]: miTierraQuerida,
  [Categories.beisbol]: baseball,
  [Categories.basketball]: basketball,
  [Categories.kids]: kids,
  [Categories.moda]: moda,
}

const categoryImage = categoryImages[currentCategory] ?? miTierraQuerida
const filteredProductList = getProductsByCategory(currentCategory)
---

<!-- Hero banner -->
<div class="relative w-full rounded-2xl overflow-hidden" transition:persist={currentCategory}>
  <Image
    class="w-full h-48 md:h-56 object-cover object-center"
    src={categoryImage}
    fetchpriority="high"
    alt={`Colección ${CategoryLabels[currentCategory]} de Serflow`}
    format="webp"
    quality={75}
    widths={[640, 1280]}
    sizes="100vw"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
    <h1 class="text-3xl md:text-4xl font-titan font-normal text-white">
      {CategoryLabels[currentCategory]}
    </h1>
    <p class="text-muted font-vend-sans text-sm mt-1">
      {filteredProductList.length} productos disponibles
    </p>
  </div>
</div>

<!-- Category tabs -->
<div class="flex gap-2 text-sm flex-wrap justify-start mt-6">
  {
    Object.values(Categories).map((category) => (
      <a
        href={`/products/${category}`}
        class={`cursor-pointer rounded-full px-5 py-2 no-underline font-vend-sans font-medium transition-all duration-300 text-sm ${
          currentCategory === category
            ? 'bg-accent text-primary'
            : 'bg-surface text-muted hover:text-white border border-primary-lighter hover:border-accent/30'
        }`}
      >
        {CategoryLabels[category]}
      </a>
    ))
  }
</div>

<!-- Product grid -->
{
  filteredProductList.length === 0 ? (
    <div class="mt-8 rounded-2xl border border-primary-lighter bg-surface p-8 text-center">
      <p class="text-muted font-vend-sans">
        No hay productos disponibles en esta categoría por ahora.
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4 mt-8">
      {
        filteredProductList.map((product, index) => (
          <ProductCard
            id={product.id}
            imagePath={product.imagePath}
            category={currentCategory}
            altText={`${CategoryLabels[currentCategory]} #${product.id}`}
            preload={index < 4}
          />
        ))
      }
    </div>
  )
}
